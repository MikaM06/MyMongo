{
  "name": "@mymongo/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "user": "tsx --env-file-if-exists=../.env src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "mongodb": "^7.5.0",
    "papaparse": "^5.7.0",
    "zod": "^4.6.7"
  }
}
