MONGODB_URI=mongodb://mymongo_app:CHANGE_ME@host.docker.internal:27017/?authSource=admin
MONGODB_LABEL=Production

MYMONGO_BIND_ADDRESS=127.0.0.1
MYMONGO_HOST_PORT=8088
MYMONGO_TRUST_PROXY=true
MYMONGO_SECURE_COOKIES=true
MYMONGO_ALLOWED_ORIGINS=https://mymongo.example.com

MYMONGO_SESSION_TTL_MINUTES=480
MYMONGO_SESSION_IDLE_MINUTES=60
MYMONGO_MAX_IMPORT_MB=16
MYMONGO_MAX_EXPORT_DOCS=100000
MYMONGO_QUERY_TIMEOUT_MS=15000
MYMONGO_LOG_LEVEL=info
